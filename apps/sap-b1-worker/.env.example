# ---------------------------------------------------------------------------
# Worker SAP Business One -> API DTE. Una instancia = una company de B1 = un RUT emisor.
# Copie a .env (ignorado por git). No suba credenciales al repositorio.
# ---------------------------------------------------------------------------

# --- Service Layer ----------------------------------------------------------
# URL base SIN /b1s/vN. Puerto habitual 50000 (HANA/MSSQL). Si el certificado es autofirmado,
# NO desactive la verificación TLS: exporte NODE_EXTRA_CA_CERTS=/ruta/ca-del-servidor.pem
SL_URL=https://b1-server:50000
# v2 (OData v4, B1 10.0 FP2011+) o v1 (OData v3).
SL_VERSION=v2
SL_COMPANY_DB=SBO_EMPRESA
SL_USER=
SL_PASSWORD=
SL_TIMEOUT_MS=30000
# Tamaño de página OData (Prefer: odata.maxpagesize)
SL_PAGINA_MAX=100

# --- API de DTE (este repositorio, apps/api) --------------------------------
API_URL=http://localhost:3000
# API key con permisos: documentos.emitir, documentos.leer, envios.crear, envios.leer
# y acceso SOLO a la empresa de EMPRESA_RUT.
API_KEY=
# RUT del emisor en la API (con DV)
EMPRESA_RUT=76086428-5
API_TIMEOUT_MS=60000

# --- Comportamiento ---------------------------------------------------------
INTERVALO_SEGUNDOS=30
# Reintenta los documentos ENVIANDO sin esperar el backoff: al arrancar y cada N minutos
CONCILIACION_MINUTOS=60
CONCURRENCIA=2
# true: tras emitir, envía al SII (POST /empresas/:rut/envios). false: quedan EMITIDO
ENVIAR_AUTOMATICAMENTE=true
# Mínimo entre dos consultas de estado al SII del mismo documento
SEGUIMIENTO_MIN_SEGUNDOS=120
# Backoff exponencial de reintentos transitorios: base * 2^(n-1), con tope
BACKOFF_BASE_MS=30000
BACKOFF_MAX_MS=600000

# --- Mapeo B1 ---------------------------------------------------------------
# Códigos de impuesto (TaxCode) que se tratan como exentos
B1_CODIGOS_EXENTOS=IVA_EXE,EXE
# PaymentGroupCode (condición de pago) considerados contado => formaPago 1; el resto => crédito (2)
B1_GRUPOS_PAGO_CONTADO=-1
# Campo del socio de negocios (OCRD) con el giro del receptor
B1_CAMPO_GIRO=U_SII_Giro
