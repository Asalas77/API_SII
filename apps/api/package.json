{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typeorm": "typeorm-ts-node-esm -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "certificacion:set": "nest build && node dist/certificacion/cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.3",
    "@xmldom/xmldom": "^0.9.12",
    "bwip-js": "^4.11.4",
    "fast-xml-parser": "^5.12.1",
    "iconv-lite": "^0.7.3",
    "imapflow": "^2.12.2",
    "joi": "^18.3.2",
    "libxml2-wasm": "^0.7.2",
    "mailparser": "^3.15.0",
    "node-forge": "^1.4.3",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.3",
    "xml-crypto": "^6.4.0",
    "xpath": "^0.0.36"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
