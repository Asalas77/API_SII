# Copiar a .env (o .env.local) y ajustar. Todas las variables se validan al arrancar.

# --- Aplicación ---
# Puerto HTTP
PORT=3000
# development | production | test
NODE_ENV=development

# --- Base de datos (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=api_sii
DATABASE_PASSWORD=api_sii
DATABASE_NAME=api_sii
# DATABASE_USER es el DUEÑO del esquema: solo lo usan las migraciones (npm run migration:*). En el
# docker local es SUPERUSER, por lo que PostgreSQL NO le aplica Row Level Security.
# La API, en runtime, debe conectarse con el ROL DE APLICACIÓN (sin SUPERUSER ni BYPASSRLS), que
# crea la migración RowLevelSecurity con esta contraseña (se lee al correr migration:run).
# Obligatorios en NODE_ENV=production (la API se niega a arrancar con un rol que salte RLS).
# Generar la contraseña con: openssl rand -base64 24
DATABASE_APP_USER=api_sii_app
DATABASE_APP_PASSWORD=cambiar-por-una-contrasena-aleatoria
# true para conexiones TLS (producción / servicios gestionados)
DATABASE_SSL=false

# --- SII ---
# Ambiente del SII: certificacion | produccion
SII_AMBIENTE=certificacion

# Res. Ex. SII 144/2026: IndTraslado 10 (guía de despacho tercerizada), 11 y 12 (traslado prolongado). El XSD oficial
# (DTE_v10.xsd de 2026-02-19) no los enumera todavía: déjelo en false hasta que el SII publique el XSD actualizado.
PERMITIR_INDTRASLADO_RES144=false

# --- Seguridad ---
# Clave maestra (32 bytes en base64) para cifrar los PFX en reposo.
# Generar con: openssl rand -base64 32
# NUNCA subir la clave real al repositorio. La de abajo es SOLO para desarrollo local.
CERTIFICADOS_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy0hISE=

# --- Autenticación ---
# Clave de administración bootstrap (opcional, mínimo 32 caracteres). Concede TODOS los permisos
# sobre TODAS las empresas: úsela solo para crear empresas y las primeras API keys
# (POST /v1/api-keys) y luego guárdela fuera de línea. Sin ella solo funcionan las API keys ya creadas.
# Generar con: openssl rand -base64 48
# Se envía como "Authorization: Bearer <clave>" o "X-API-Key: <clave>".
# API_ADMIN_KEY=

# --- Recepción de DTE de proveedores (buzón de correo de intercambio) ---
# Sondeo automático (IMAP) de los buzones configurados con PUT /v1/empresas/{rut}/buzon-correo.
# Desactivado por defecto y nunca arranca con NODE_ENV=test. Sin él, la recepción por subida de archivo
# (POST /v1/empresas/{rut}/recepcion) y el sondeo manual (POST .../buzon-correo/sondear) funcionan igual.
BUZON_CORREO_HABILITADO=false
# Cada cuántos segundos se revisa qué buzones ya cumplieron su intervalo (mínimo 5).
BUZON_CORREO_TICK_SEGUNDOS=30
